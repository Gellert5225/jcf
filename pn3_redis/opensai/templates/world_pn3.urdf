<?xml version="1.0" ?>
<!-- OpenSai world for the PN3 driver: the human model is the robot "pn3", so SimViz reads
     sai::sensors::pn3::joint_positions (prefix "sai", set in pn3_viz.xml). Generated by pn3_redis/opensai/make_bundle.py. -->
<world name="pn3_world" gravity="0.0 0.0 -9.81">

	<robot name="pn3">
		<!-- model name must equal the <robot name> inside Rajagopal2015.urdf -->
		<model dir="${ROBOT_FILES_FOLDER}/rajagopal" path="Rajagopal2015.urdf"
		       name="FullBodyModel_MuscleActuatedLowerLimb_TorqueActuatedUpperBody_converted" />
	</robot>

	<!-- floor top at z = -0.0125: the driver puts the heels (calcn origins) at z = 0 and the foot meshes
	     reach about 1 cm below them (visual only) -->
	<static_object name="Floor">
		<origin xyz="0.0 0.0 -0.0625" rpy="0 0 0" />
		<visual>
			<origin xyz="0.0 0.0 0.0" rpy="0 0 0" />
			<geometry>
				<box size="12 3 0.1" />
			</geometry>
			<material name="material_gray">
				<color rgba="0.5 0.5 0.5 1.0" />
			</material>
		</visual>
	</static_object>

	<light name="light1" type="directional">
		<position xyz="2.0 -3.0 3.0" />
		<lookat xyz="0.0 0.0 1.0" />
	</light>

	<light name="light2" type="directional">
		<position xyz="-2.0 3.0 3.0" />
		<lookat xyz="0.0 0.0 1.0" />
	</light>

	<!-- sai-graphics sorts cameras by name and opens on the first: the side view. N / B switch cameras.
	     With the driver's --viz-wrap-m 4 the pelvis stays within x in [-2, 2). -->
	<camera name="camera_1_side">
		<position xyz="0.0 -5.0 1.2" />
		<vertical xyz="0.0 0.0 1.0" />
		<lookat xyz="0.0 0.0 0.9" />
	</camera>

	<camera name="camera_2_front">
		<position xyz="4.5 0.0 1.3" />
		<vertical xyz="0.0 0.0 1.0" />
		<lookat xyz="0.0 0.0 0.9" />
	</camera>

</world>
